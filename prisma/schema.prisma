generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TEAM_MANAGER
  CLIENT
}

enum CourseStatus {
  AVAILABLE
  COMING_SOON
  ARCHIVED
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum ModuleProgressStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Business {
  SENSORY_SUBMARINE
  LITTLE_SENSORY_EXPLORERS
  SENSORY_EATERS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CLIENT)
  business     Business?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dashTemplateId String?
  dashTemplate   DashTemplate? @relation(fields: [dashTemplateId], references: [id], onDelete: SetNull)

  // Preferred sidebar order — array of navKey strings (e.g. "nav_dashboard").
  // Empty array = use the default order.
  navOrder       String[]      @default([])

  managedClients  Client[]       @relation("ManagerClients")
  parentOfClients Client[]       @relation("ParentClients")
  reports         Report[]       @relation("AuthoredReports")
  sessions        TherapySession[] @relation("TherapistSessions")
  enrollments     Enrollment[]   @relation("UserEnrollments")
  setupTokens     PasswordSetupToken[]
  coursePurchases CoursePurchase[]
  learnerNotes    LearnerNote[]
  tasksCreated    Task[]         @relation("TasksCreated")
  tasksForClient  Task[]         @relation("TasksForClient")
  taskAssignments TaskAssignee[]
  taskComments    TaskComment[]
  progressNotes   ProgressNote[]
  formsCreated    Form[]         @relation("FormsCreated")
  leafletsCreated Leaflet[]      @relation("LeafletsCreated")
}

model PasswordSetupToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ImpersonationToken {
  id             String    @id @default(cuid())
  token          String    @unique
  adminUserId    String    // the SUPER_ADMIN who issued the token
  targetUserId   String    // the user to sign in as
  originalAdminId String?  // if set, this token exits impersonation back to this admin
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
}

model ClientStage {
  id        String   @id @default(cuid())
  label     String
  colour    String   @default("#6B7280")
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  clients   Client[]
}

// ─── Dashboard Templates ────────────────────────────────────────────
model DashTemplate {
  id        String   @id @default(cuid())
  name      String
  widgets   String[] // array of widget keys visible in this template
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Client {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  diagnosis          String?
  presentingConcerns String?
  referrer           String?
  parentCarerName    String?
  parentCarerEmail   String?
  currency           String   @default("GBP") // GBP | EUR | USD
  business           Business @default(SENSORY_SUBMARINE)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stageId String?
  stage   ClientStage? @relation(fields: [stageId], references: [id])

  managerId String?
  manager   User?   @relation("ManagerClients", fields: [managerId], references: [id])
  parentId  String?
  parent    User?   @relation("ParentClients", fields: [parentId], references: [id])

  sessions      TherapySession[]
  reports       Report[]
  progressNotes ProgressNote[]
  goals         ClientGoal[]
  intakeItems   ClientIntakeItem[]
  invoices      Invoice[]
  formInvites   FormInvite[]

  @@index([stageId])
}

model TherapySession {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  therapistId   String
  therapist     User     @relation("TherapistSessions", fields: [therapistId], references: [id])
  sessionDate   DateTime
  sessionNumber Int
  rawNotes      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  report Report?
}

model Report {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  sessionId  String   @unique
  session    TherapySession @relation(fields: [sessionId], references: [id])
  authorId   String
  author     User     @relation("AuthoredReports", fields: [authorId], references: [id])
  reportDate DateTime @default(now())
  reviewDate DateTime?
  status     String   @default("draft")
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Activity {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  targetArea  String[]
  ageRange    String?
  equipment   String[]
  business    Business @default(SENSORY_SUBMARINE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  audience    String
  duration    String
  description String
  status      CourseStatus @default(AVAILABLE)
  order       Int          @default(0)
  price       Int          @default(0) // pounds; 0 = free
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  purchases   CoursePurchase[]
}

model Module {
  id        String   @id @default(cuid())
  courseId   String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  content   Json
  questions Json
  videoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress  ModuleProgress[]
  notes     LearnerNote[]
}

model Enrollment {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation("UserEnrollments", fields: [userId], references: [id])
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id])
  status       EnrollmentStatus @default(IN_PROGRESS)
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?
  updatedAt    DateTime         @updatedAt

  moduleProgress ModuleProgress[]

  @@unique([userId, courseId])
}

model ModuleProgress {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     String
  module       Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status       ModuleProgressStatus @default(LOCKED)
  score        Int?
  attempts     Int                  @default(0)
  completedAt  DateTime?
  updatedAt    DateTime             @updatedAt

  @@unique([enrollmentId, moduleId])
}

model CoursePurchase {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount        Int // snapshot of Course.price at purchase time (pounds)
  paymentStatus String    @default("pending") // "pending" | "paid" | "failed"
  paymentRef    String?   @unique // FireBuddy transaction id
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId, courseId])
}

model LearnerNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  body      String
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleId])
}

model EmailSettings {
  id           String   @id @default("default")
  provider     String   @default("mailcub")
  apiKey       String?
  senderEmail  String?
  senderName   String   @default("The Sensory Submarine")
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AiSettings {
  id        String   @id @default("default")
  provider  String   @default("anthropic")
  apiKey    String?
  model     String   @default("claude-sonnet-4-20250514")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentSettings {
  id             String   @id @default("default")
  provider       String   @default("firebuddy")
  apiKey         String?
  webhookSecret  String?
  enabled        Boolean  @default(false)
  // Accepted currencies — always contains GBP and EUR (enforced in API).
  currencies     String[] @default(["GBP", "EUR"])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TaxRate {
  id        String   @id @default(cuid())
  currency  String                    // "GBP" | "EUR" | "USD" — multiple rates allowed per currency
  label     String   @default("VAT")  // e.g. "VAT", "Reduced VAT", "Zero", "Sales Tax"
  rate      Float    @default(0)      // percentage, e.g. 23.0 for 23%
  enabled   Boolean  @default(true)   // show as a selectable option on invoice creation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currency])
}

// Home programme templates — the reusable programmes shown on /programmes.
// Sections is stored as JSON: Array<{ title: string; items: string[] }>.
model ProgrammeTemplate {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  sections    Json     @default("[]") // [{ title, items: [...] }]
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderIndex])
}

model WeeklyHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  enabled   Boolean  @default(false)
  intervals Json     // [{"start":"09:00","end":"17:00"}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
}

model DateOverride {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  available Boolean  @default(false)
  intervals Json?    // null if unavailable, otherwise [{"start":"10:00","end":"14:00"}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
}

model Booking {
  id            String   @id @default(cuid())
  service       String
  date          DateTime
  time          String
  duration      String
  price         Int
  clientName    String
  clientEmail   String
  clientPhone   String?
  notes         String?
  status        String   @default("pending")
  paymentStatus String   @default("unpaid")
  paymentRef    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PrivateConfig {
  id         String   @id @default("singleton")
  incomeGoal Int      @default(250000)
  updatedAt  DateTime @updatedAt
}

model IncomeEntry {
  id          String   @id @default(cuid())
  amount      Int // amount in GBP (pounds)
  source      String // "BOOKING" | "MANUAL" | "FIREBUDDY"
  reference   String? // e.g. booking id, external payment id
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([source, reference])
  @@index([occurredAt])
}

model Task {
  id            String   @id @default(cuid())
  title         String
  description   String?
  priority      String   @default("medium") // "low" | "medium" | "high" | "urgent"
  status        String   @default("todo")   // "todo" | "in_progress" | "done"
  dueDate       DateTime?
  createdById   String
  createdBy     User     @relation("TasksCreated", fields: [createdById], references: [id])
  // If set, this task is shared with this CLIENT user via /portal/feedback.
  clientUserId  String?
  clientUser    User?    @relation("TasksForClient", fields: [clientUserId], references: [id])
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignees     TaskAssignee[]
  subtasks      Subtask[]
  comments      TaskComment[]

  @@index([status])
  @@index([dueDate])
  @@index([clientUserId])
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Subtask {
  id      String  @id @default(cuid())
  taskId  String
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title   String
  done    Boolean @default(false)
  order   Int     @default(0)

  @@index([taskId])
}

model TaskComment {
  id          String              @id @default(cuid())
  taskId      String
  task        Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime            @default(now())
  attachments CommentAttachment[]

  @@index([taskId])
}

model CommentAttachment {
  id        String      @id @default(cuid())
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  mimeType  String
  filename  String
  sizeBytes Int
  createdAt DateTime    @default(now())

  @@index([commentId])
}

// ─── Progress Notes (SOAP format) ───────────────────────────────────

model ProgressNote {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  sessionDate DateTime
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

// ─── Client Goals + Reviews ─────────────────────────────────────────

model ClientGoal {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  achieved    Boolean   @default(false)
  reviewNote  String?   @db.Text
  parentNote  String?   @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
}

// ─── Invoices ───────────────────────────────────────────────────────

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique            // e.g. "INV-0001"
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName    String                       // snapshot — always filled even if no clientId
  clientEmail   String
  currency      String    @default("GBP")    // GBP | EUR | USD
  status        String    @default("draft")  // "draft" | "sent" | "paid" | "overdue" | "cancelled"
  dueDate       DateTime
  notes         String?   @db.Text
  subtotal      Int       @default(0)        // pence
  tax           Int       @default(0)        // pence
  total         Int       @default(0)        // pence
  paymentRef    String?                      // FireBuddy payment code
  paymentUrl    String?                      // FireBuddy payment URL
  paidAt        DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  items         InvoiceItem[]

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int    @default(1)
  unitPrice   Int                            // pence
  amount      Int                            // quantity * unitPrice, in pence

  @@index([invoiceId])
}

// ─── Client Intake Items (questionnaires, SPM, etc.) ────────────────

model ClientIntakeItem {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String    // "parent_questionnaire" | "spm" | custom
  label       String
  url         String?
  status      String    @default("pending") // "pending" | "sent" | "completed"
  sentAt      DateTime?
  completedAt DateTime?
  notes       String?   @db.Text
  fileUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
}

// ─── Forms — JotForm-style builder + public submissions ────────────
// Fields and settings are stored as JSON; canonical types live in
// src/lib/forms.ts. Sanitisation happens on every read/write boundary.
model Form {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique               // public path: /f/{slug}
  description String?  @db.Text
  fields      Json     @default("[]")        // Array<FormField>
  settings    Json     @default("{}")        // { submitButtonText, successMessage, notifyEmails, replyToEmail, autoReply? }
  isPublished Boolean  @default(false)
  createdById String
  createdBy   User     @relation("FormsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  submissions FormSubmission[]
  invites     FormInvite[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model FormSubmission {
  id             String      @id @default(cuid())
  formId         String
  form           Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  inviteId       String?
  invite         FormInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  data           Json                              // { [fieldId]: value }
  fieldsSnapshot Json                              // frozen copy of Form.fields at submit time
  submitterEmail String?                           // denormalised from the first email field
  submitterName  String?                           // denormalised from the first name-ish text field
  submittedAt    DateTime    @default(now())
  ipHash         String?                           // SHA256 of IP — lightweight abuse signal

  @@index([formId, submittedAt])
}

model FormInvite {
  id          String           @id @default(cuid())
  formId      String
  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  email       String
  token       String           @unique           // embedded as ?t= on the public URL
  sentAt      DateTime         @default(now())
  openedAt    DateTime?
  submissions FormSubmission[]

  @@index([formId])
  @@index([token])
}

// ─── Leaflets — a library of parent/carer handouts ────────────────
// Each leaflet is either a file uploaded to Vercel Blob or an external URL
// (e.g. Google Drive). The UI gallery filters by category, searches by title.
model Leaflet {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  category     String?  // free-text label, e.g. "Fine Motor", "Feeding"
  fileUrl      String   // Blob URL or external (Drive, etc.)
  fileName     String?  // display filename (original upload name)
  mimeType     String?
  sizeBytes    Int?
  thumbnailUrl String?  // optional preview image URL
  tags         String[] @default([])
  external     Boolean  @default(false) // true when fileUrl points off-app
  createdById  String
  createdBy    User     @relation("LeafletsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([createdById])
}
