generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TEAM_MANAGER
  CLIENT
}

enum CourseStatus {
  AVAILABLE
  COMING_SOON
  ARCHIVED
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum ModuleProgressStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Business {
  SENSORY_SUBMARINE
  LITTLE_SENSORY_EXPLORERS
  SENSORY_EATERS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CLIENT)
  business     Business?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedClients  Client[]       @relation("ManagerClients")
  parentOfClients Client[]       @relation("ParentClients")
  reports         Report[]       @relation("AuthoredReports")
  sessions        TherapySession[] @relation("TherapistSessions")
  enrollments     Enrollment[]   @relation("UserEnrollments")
}

model Client {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  diagnosis          String?
  presentingConcerns String?
  referrer           String?
  parentCarerName    String?
  parentCarerEmail   String?
  business           Business @default(SENSORY_SUBMARINE)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  managerId String?
  manager   User?   @relation("ManagerClients", fields: [managerId], references: [id])
  parentId  String?
  parent    User?   @relation("ParentClients", fields: [parentId], references: [id])

  sessions TherapySession[]
  reports  Report[]
}

model TherapySession {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  therapistId   String
  therapist     User     @relation("TherapistSessions", fields: [therapistId], references: [id])
  sessionDate   DateTime
  sessionNumber Int
  rawNotes      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  report Report?
}

model Report {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  sessionId  String   @unique
  session    TherapySession @relation(fields: [sessionId], references: [id])
  authorId   String
  author     User     @relation("AuthoredReports", fields: [authorId], references: [id])
  reportDate DateTime @default(now())
  reviewDate DateTime?
  status     String   @default("draft")
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Activity {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  targetArea  String[]
  ageRange    String?
  equipment   String[]
  business    Business @default(SENSORY_SUBMARINE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  audience    String
  duration    String
  description String
  status      CourseStatus @default(AVAILABLE)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id        String   @id @default(cuid())
  courseId   String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  content   Json
  questions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress  ModuleProgress[]
}

model Enrollment {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation("UserEnrollments", fields: [userId], references: [id])
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id])
  status       EnrollmentStatus @default(IN_PROGRESS)
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?
  updatedAt    DateTime         @updatedAt

  moduleProgress ModuleProgress[]

  @@unique([userId, courseId])
}

model ModuleProgress {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     String
  module       Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status       ModuleProgressStatus @default(LOCKED)
  score        Int?
  attempts     Int                  @default(0)
  completedAt  DateTime?
  updatedAt    DateTime             @updatedAt

  @@unique([enrollmentId, moduleId])
}

model EmailSettings {
  id           String   @id @default("default")
  provider     String   @default("mailcub")
  apiKey       String?
  senderEmail  String?
  senderName   String   @default("The Sensory Submarine")
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AiSettings {
  id        String   @id @default("default")
  provider  String   @default("anthropic")
  apiKey    String?
  model     String   @default("claude-sonnet-4-20250514")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentSettings {
  id             String   @id @default("default")
  provider       String   @default("firebuddy")
  apiKey         String?
  webhookSecret  String?
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WeeklyHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  enabled   Boolean  @default(false)
  intervals Json     // [{"start":"09:00","end":"17:00"}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
}

model DateOverride {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  available Boolean  @default(false)
  intervals Json?    // null if unavailable, otherwise [{"start":"10:00","end":"14:00"}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
}

model Booking {
  id            String   @id @default(cuid())
  service       String
  date          DateTime
  time          String
  duration      String
  price         Int
  clientName    String
  clientEmail   String
  clientPhone   String?
  notes         String?
  status        String   @default("pending")
  paymentStatus String   @default("unpaid")
  paymentRef    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
