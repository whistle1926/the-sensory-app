generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TEAM_MANAGER
  CLIENT
}

enum CourseStatus {
  AVAILABLE
  COMING_SOON
  ARCHIVED
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum ModuleProgressStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Business {
  SENSORY_SUBMARINE
  LITTLE_SENSORY_EXPLORERS
  SENSORY_EATERS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CLIENT)
  business     Business?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dashTemplateId String?
  dashTemplate   DashTemplate? @relation(fields: [dashTemplateId], references: [id], onDelete: SetNull)

  // Preferred sidebar order — array of navKey strings (e.g. "nav_dashboard").
  // Empty array = use the default order.
  navOrder       String[]      @default([])

  managedClients  Client[]       @relation("ManagerClients")
  parentOfClients Client[]       @relation("ParentClients")
  reports         Report[]       @relation("AuthoredReports")
  homeProgrammes  HomeProgramme[] @relation("AuthoredHomeProgrammes")
  sessions        TherapySession[] @relation("TherapistSessions")
  enrollments     Enrollment[]   @relation("UserEnrollments")
  setupTokens     PasswordSetupToken[]
  coursePurchases CoursePurchase[]
  learnerNotes    LearnerNote[]
  tasksCreated    Task[]         @relation("TasksCreated")
  tasksForClient  Task[]         @relation("TasksForClient")
  taskAssignments TaskAssignee[]
  taskComments    TaskComment[]
  progressNotes   ProgressNote[]
  formsCreated    Form[]         @relation("FormsCreated")
  leafletsCreated Leaflet[]      @relation("LeafletsCreated")
  notes           Note[]         @relation("UserNotes")
  liveRoomsHosted LiveRoom[]     @relation("LiveRoomsHosted")
  auditEntries    AuditLog[]     @relation("AuditEntries")
  // Booking services this associate runs (self-serve availability).
  ownedBookingServices BookingService[] @relation("BookingServiceOwner")

  // ── Calendar integration (per-user) ──────────────────────────────
  // Each staff member can paste their Google Calendar's "Secret
  // address in iCal format" URL so their events appear on the team
  // calendar view. Read-only — Patrick decided ICS was the right
  // MVP over full OAuth (zero Google Cloud setup, ~15-min freshness
  // is fine for ops planning). Colour is a hex string for the chip
  // shown next to each person's events on the agenda.
  calendarIcsUrl  String?
  calendarColour  String? // e.g. "#3b82f6" — defaults applied at render

  // ── Google Calendar WRITE sync (per-user OAuth) ───────────────────
  // Separate from the read-only iCal feed above: this is the two-way
  // side. When a staff member connects via OAuth we store the offline
  // refresh token (scope: calendar.events only) so booking creation can
  // insert an event straight into their Google diary, and cancellation
  // can delete it. googleTokenEmail records which Google account granted
  // access; googleCalendarId is which calendar to write to ("primary").
  googleRefreshToken String?   @map("google_refresh_token")
  googleTokenEmail   String?   @map("google_token_email")
  googleCalendarId   String?   @map("google_calendar_id")
  googleConnectedAt  DateTime? @map("google_connected_at")

  // ── Therapist profile (shown on the public booking page) ──────────
  // Surfaced when a parent picks a clinic location so they can see who
  // they'll be seeing. Edited by an admin in Team → View Profile.
  photoUrl        String? // headshot, uploaded via admin → Vercel Blob
  bio             String? @db.Text
  phone           String? // contact number shown on the clinic card

  // ── Email signatures (multi) ────────────────────────────────────
  // Stored inline as JSON rather than a separate table because
  // signatures are short, per-user, and only ever read with the user.
  // Shape: Array<{ id: string; label: string; body: string }>.
  // The signature picker on the report-summary dialog lists these by
  // `label`; the chosen `body` is appended to the email when sending.
  emailSignatures Json    @default("[]")

  // ── Personal-note presets ───────────────────────────────────────
  // Same shape as signatures: Array<{ id, label, body }>. Used to
  // pre-fill the "Personal note" field on the report-summary dialog
  // for high-volume admins (up to 100 reports/month). Supports a
  // single template token, `{{clientName}}`, substituted at apply
  // time so one preset works across many clients.
  personalNotePresets Json @default("[]")
}

model PasswordSetupToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ImpersonationToken {
  id             String    @id @default(cuid())
  token          String    @unique
  adminUserId    String    // the SUPER_ADMIN who issued the token
  targetUserId   String    // the user to sign in as
  originalAdminId String?  // if set, this token exits impersonation back to this admin
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
}

model ClientStage {
  id        String   @id @default(cuid())
  label     String
  colour    String   @default("#6B7280")
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  clients   Client[]
}

// ─── Dashboard Templates ────────────────────────────────────────────
model DashTemplate {
  id        String   @id @default(cuid())
  name      String
  widgets   String[] // array of widget keys visible in this template
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Client {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  diagnosis          String?
  presentingConcerns String?
  referrer           String?
  parentCarerName    String?
  parentCarerEmail   String?
  // Billing address used to pre-fill invoices. Free-text, multi-line.
  address            String?  @db.Text
  currency           String   @default("GBP") // GBP | EUR | USD
  business           Business @default(SENSORY_SUBMARINE)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stageId String?
  stage   ClientStage? @relation(fields: [stageId], references: [id])

  managerId String?
  manager   User?   @relation("ManagerClients", fields: [managerId], references: [id])
  parentId  String?
  parent    User?   @relation("ParentClients", fields: [parentId], references: [id])

  sessions      TherapySession[]
  reports       Report[]
  homeProgrammes HomeProgramme[]
  progressNotes ProgressNote[]
  goals         ClientGoal[]
  intakeItems   ClientIntakeItem[]
  invoices      Invoice[]
  formInvites   FormInvite[]

  @@index([stageId])
  // Dashboard filters active clients, often within a recent window.
  @@index([active, createdAt])
}

model TherapySession {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  therapistId   String
  therapist     User     @relation("TherapistSessions", fields: [therapistId], references: [id])
  sessionDate   DateTime
  sessionNumber Int
  rawNotes      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  report Report?
}

model Report {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  sessionId  String   @unique
  session    TherapySession @relation(fields: [sessionId], references: [id])
  authorId   String
  author     User     @relation("AuthoredReports", fields: [authorId], references: [id])
  reportDate DateTime @default(now())
  reviewDate DateTime?
  status     String   @default("draft")
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Dashboard lists recent reports + filters by status.
  @@index([createdAt])
  @@index([status])
  @@index([clientId])
}

model Activity {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  targetArea  String[]
  ageRange    String?
  equipment   String[]
  business    Business @default(SENSORY_SUBMARINE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A standalone home programme — decoupled from reports. Grace often
/// sends a home programme to a parent without writing a whole report
/// (especially for long-standing clients), so these live on their own
/// and can be created, edited, exported (PDF) and emailed directly.
/// `body` is plain text in the exact same format the in-report
/// HomeProgrammeEditor produces, so the template/activity/leaflet
/// insert pickers and the export styling are reused unchanged.
model HomeProgramme {
  id        String    @id @default(cuid())
  // Optional client link — a programme is usually tied to a child (so
  // it appears on their profile and we can pre-fill the parent's
  // email), but a one-off can be drafted without one. SetNull so
  // deleting a client doesn't cascade-delete their programme history.
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  authorId  String?
  author    User?     @relation("AuthoredHomeProgrammes", fields: [authorId], references: [id], onDelete: SetNull)
  title     String    @default("Home Programme")
  body      String    @db.Text @default("")
  status    String    @default("draft") // draft | sent
  sentAt    DateTime?
  sentTo    String?   // email the most recent copy went to
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId])
  @@index([status, createdAt])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  audience    String
  duration    String
  description String
  status      CourseStatus @default(AVAILABLE)
  order       Int          @default(0)
  price       Int          @default(0) // pounds; 0 = free
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ── Storefront cosmetics (public /courses pages) ────────────
  heroImageUrl        String?                 // large banner on detail page (16:9)
  thumbnailUrl        String?                 // storefront card (4:3); falls back to heroImageUrl when null
  tagline             String?                 // optional one-line catchphrase under title
  shortDescription    String?                 // card blurb, ~120 chars
  level               String?                 // "Beginner" | "Intermediate" | "Advanced" or free text
  features            String[] @default([])   // "What you'll learn" bullet list
  accreditationBadges String[] @default([])   // image URLs for approval logos (AOTA-style)
  instructorName      String?
  instructorRole      String?
  instructorBio       String?  @db.Text
  instructorImageUrl  String?
  testimonials        Json     @default("[]") // Array<{ quote, author, role?, avatarUrl? }>
  isFeatured          Boolean  @default(false) // appears in the featured row on storefront
  isBestseller        Boolean  @default(false) // shows a "Bestseller" badge on card

  /// "Who this is for" — single paragraph rendered as a callout on the
  /// course detail page. Null/empty hides the block.
  audienceFor  String? @db.Text @map("audience_for")
  /// Optional recommendation surfaced on the completion screen as the
  /// "Continue your learning" suggestion. Self-referential FK; deleting
  /// the recommended course nulls this out rather than cascading.
  nextCourseId String? @map("next_course_id")
  nextCourse   Course? @relation("CourseProgression", fields: [nextCourseId], references: [id], onDelete: SetNull)
  /// Back-relation — courses that recommend THIS course as a follow-up.
  prevCourses  Course[] @relation("CourseProgression")

  modules     Module[]
  enrollments Enrollment[]
  purchases   CoursePurchase[]
}

model Module {
  id             String   @id @default(cuid())
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  order          Int
  content        Json
  questions      Json
  videoUrl       String?
  coverImageUrl  String?  // 16:9 illustration shown as the lesson hero when no video
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  progress  ModuleProgress[]
  notes     LearnerNote[]
}

model Enrollment {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation("UserEnrollments", fields: [userId], references: [id])
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id])
  status       EnrollmentStatus @default(IN_PROGRESS)
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?
  updatedAt    DateTime         @updatedAt

  moduleProgress ModuleProgress[]

  @@unique([userId, courseId])
}

model ModuleProgress {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     String
  module       Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status       ModuleProgressStatus @default(LOCKED)
  score        Int?
  attempts     Int                  @default(0)
  completedAt  DateTime?
  updatedAt    DateTime             @updatedAt

  @@unique([enrollmentId, moduleId])
}

model CoursePurchase {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount        Int // snapshot of Course.price at purchase time (pounds)
  paymentStatus String    @default("pending") // "pending" | "paid" | "failed"
  paymentRef    String?   @unique // FireBuddy transaction id
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  // ── Paid-traffic attribution ───────────────────────────────────────
  // Captured client-side when the visitor first lands on /courses (or
  // any public page) with UTM query params. Persisted to sessionStorage
  // and sent with the checkout body so we can see which ad creative
  // produced the order. All optional — direct/organic visitors leave
  // these null.
  utmSource   String? @map("utm_source")    // e.g. "meta", "google", "tiktok"
  utmMedium   String? @map("utm_medium")    // e.g. "cpc", "social", "email"
  utmCampaign String? @map("utm_campaign")  // e.g. "courses-launch-may26"
  utmContent  String? @map("utm_content")   // e.g. "carousel-3-childpaint"
  utmTerm     String? @map("utm_term")      // search keyword if Google Search
  /// Referring URL at the moment of order creation — useful when ad
  /// platform strips UTMs (some browsers do).
  referrer    String? @map("referrer") @db.Text

  @@index([userId, courseId])
  @@index([utmCampaign])
}

model LearnerNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  body      String
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleId])
}

model EmailSettings {
  id           String   @id @default("default")
  provider     String   @default("mailcub")
  apiKey       String?
  senderEmail  String?
  senderName   String   @default("The Sensory Submarine")
  /// Where client replies go. The "from" must be a verified Mailcub
  /// sender (a mail.* subdomain), which isn't a monitored inbox — so
  /// set this to the real inbox (e.g. info@thesensorysubmarine.com) and
  /// it's added as the Reply-To on every outgoing email.
  replyTo      String?
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AiSettings {
  id        String   @id @default("default")
  provider  String   @default("anthropic")
  apiKey    String?
  model     String   @default("claude-sonnet-4-6")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentSettings {
  id             String   @id @default("default")
  provider       String   @default("firebuddy")
  apiKey         String?
  webhookSecret  String?
  enabled        Boolean  @default(false)
  // Accepted currencies — always contains GBP and EUR (enforced in API).
  currencies     String[] @default(["GBP", "EUR"])

  // ── Bank transfer details (two accounts) ────────────────────────
  // Shown on an invoice when its `bankTransfer` flag is on. The block
  // shown depends on the invoice currency: GBP invoices show the
  // Sterling account, EUR invoices show the Euro account.
  //
  // Sterling (GBP) account:
  bankAccountName          String? @map("bank_account_name")     // account holder name
  bankSortCode             String? @map("bank_sort_code")
  bankAccountNumber        String? @map("bank_account_number")
  // Euro (EUR) account:
  bankEurAccountName       String? @map("bank_eur_account_name") // falls back to bankAccountName when blank
  bankIban                 String? @map("bank_iban")
  bankBic                  String? @map("bank_bic")
  // Shared instructions line (both accounts):
  bankTransferInstructions String? @db.Text @map("bank_transfer_instructions")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TaxRate {
  id        String   @id @default(cuid())
  currency  String                    // "GBP" | "EUR" | "USD" — multiple rates allowed per currency
  label     String   @default("VAT")  // e.g. "VAT", "Reduced VAT", "Zero", "Sales Tax"
  rate      Float    @default(0)      // percentage, e.g. 23.0 for 23%
  enabled   Boolean  @default(true)   // show as a selectable option on invoice creation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services  Service[] // services that default to this rate

  @@index([currency])
}

// Home programme templates — the reusable programmes shown on /programmes.
// Sections is stored as JSON: Array<{ title: string; items: string[] }>.
model ProgrammeTemplate {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  sections    Json     @default("[]") // [{ title, items: [...] }]
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderIndex])
}

model WeeklyHours {
  id        String   @id @default(cuid())
  // Soft FK to BookingService.id. NULL = the legacy "default" schedule
  // used by any service that hasn't set its own hours yet (back-compat
  // with the original single-calendar model). A service with at least
  // one row of its own uses those instead of the default.
  serviceId String?  @map("service_id")
  dayOfWeek Int      // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  enabled   Boolean  @default(false)
  intervals Json     // [{"start":"09:00","end":"17:00"}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per (service, day). serviceId NULL rows are the global default.
  @@unique([serviceId, dayOfWeek])
  @@index([serviceId])
}

model DateOverride {
  id        String   @id @default(cuid())
  // Soft FK to BookingService.id. NULL = applies to the default schedule.
  // Per-service overrides are how monthly assessment clinics are modelled
  // (specific dates rather than a recurring weekly day).
  serviceId String?  @map("service_id")
  date      DateTime @db.Date
  available Boolean  @default(false)
  intervals Json?    // null if unavailable, otherwise [{"start":"10:00","end":"14:00"}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, date])
  @@index([serviceId])
}

/// Admin-editable catalogue of booking services. Replaces the
/// hardcoded array that used to live in src/app/book/page.tsx. Each
/// row is uniquely addressable at /book/[slug] for ads + per-service
/// share links.
///
/// Booking.service stores the slug (free text — soft FK so we don't
/// fail an old booking if its service gets renamed).
model BookingService {
  id              String   @id @default(cuid())
  /// URL slug — `initial-ot` produces /book/initial-ot.
  slug            String   @unique
  title           String
  /// Long marketing description shown on the public booking page and
  /// in the per-service landing page hero. Rich text supported.
  description     String   @db.Text @default("")
  /// Short tagline / sub-line on cards.
  tagline         String?
  /// "Parents & individuals" / "Schools & community" / free text. Used
  /// to group services on /book and in the admin list.
  category        String   @default("")
  /// Price in pence — 0 = free / quote. For a multi-session service
  /// (maxSessions > 1) this is the PER-SESSION price: the client is
  /// charged pricePence × the number of dates they pick.
  pricePence      Int      @default(0)

  /// How many dates the client picks in one booking.
  ///   1 / 1  → an ordinary single appointment (the default).
  ///   2 / 5  → a block: they must choose between 2 and 5 dates, each
  ///            becomes its own linked appointment, and the total is
  ///            pricePence × the number chosen.
  /// Admin-set per service in Bookings → Services.
  minSessions     Int      @default(1) @map("min_sessions")
  maxSessions     Int      @default(1) @map("max_sessions")
  /// Friendly duration label ("60 minutes", "5 × 60 mins") shown on
  /// cards. The booking calendar always uses durationMinutes for the
  /// time-slot math.
  durationLabel   String   @default("")
  durationMinutes Int      @default(60)
  /// Optional non-refundable deposit (e.g. £100 to secure an
  /// assessment). Falls back to 0 = no deposit. Snapshot copied onto
  /// the Booking row at checkout time.
  depositPence    Int      @default(0)
  /// false = hide from public /book entirely. true = appear in the
  /// listing AND the per-slug URL works.
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  /// Optional Lucide icon name for the card — falls back to a default
  /// generic icon on render. Picked from a small allowlist.
  iconKey         String?
  /// Optional accent colour for the card stripe.
  accentColor     String?

  /// The associate who runs this service. NULL = the practice
  /// (Grace/Patrick) — unassigned services book against the default
  /// calendar and notify the practice inbox. When set, the service's
  /// availability is managed by this user (self-serve) and bookings
  /// are attributed to them.
  ownerId         String?  @map("owner_id")
  owner           User?    @relation("BookingServiceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// When true, paying for a booking of this service automatically emails
  /// the client the intake/referral form (the published form flagged
  /// `createsClient`). Used for OT assessments so the referral form goes
  /// out the moment payment lands. Admin-controlled per service.
  autoSendReferralForm Boolean @default(false) @map("auto_send_referral_form")

  /// Delivery mode — drives the location/online wording shown to
  /// parents and in reminder emails. "in_person" | "online" | "home".
  mode            String   @default("in_person")
  /// Human-readable location for in-person services (e.g. "Armagh",
  /// "Antrim", "Ballymoney"). Shown as a badge on the booking card.
  /// Ignored for online services.
  locationLabel   String?  @map("location_label")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, order])
  @@index([ownerId])
  @@map("booking_services")
}

model Booking {
  id            String   @id @default(cuid())
  service       String
  // Snapshot of the owning associate (BookingService.ownerId) at booking
  // time. Soft FK to User.id; denormalised so reassigning a service later
  // doesn't move historical bookings, and so availability generation can
  // cheaply find all of an owner's booked slots to prevent double-booking
  // the same person across their different services. NULL = the practice.
  ownerId       String?  @map("owner_id")
  date          DateTime
  time          String
  duration      String
  price         Int
  clientName    String
  clientEmail   String
  clientPhone   String?
  notes         String?
  status        String   @default("pending")
  paymentStatus String   @default("unpaid")
  paymentRef    String?
  // Links the sessions of a multi-session block booking so they can be
  // shown/paid/cancelled together. Each session is still its own row (so
  // it occupies its own calendar slot and can't be double-booked), and
  // each row's `price` is the PER-SESSION price — the block is paid once
  // via a single payment request for the group total.
  // NULL on ordinary single appointments.
  groupId       String?  @map("group_id")
  // Position within the block, 1-based (1 of 5, 2 of 5...). NULL if single.
  sessionIndex  Int?     @map("session_index")
  // Stamped the first time the intake/referral form is auto-emailed to
  // this client on payment (see src/lib/booking-referral.ts). Idempotency
  // key so the webhook firing twice never double-sends the form.
  referralFormSentAt DateTime? @map("referral_form_sent_at")
  // Google Calendar event id, set when this booking was written to the
  // owner's connected Google calendar (OAuth write sync). Used to delete
  // the event if the booking is cancelled. NULL = never synced.
  googleEventId String? @map("google_event_id")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Booking T&C consent (captured during /book step 3) ──────────────
  // Audit trail of which terms version the client agreed to. Required for
  // any new booking; populated server-side from the version constant in
  // src/lib/booking-terms.ts at submission time.
  acceptedTermsAt      DateTime? @map("accepted_terms_at")
  acceptedTermsVersion String?   @map("accepted_terms_version")
  // Snapshot of deposit policy that applied to THIS booking. Set
  // automatically for "initial-ot" today; future booking types could
  // require deposits too. depositAmount is in pence to match `price`.
  depositRequired      Boolean   @default(false) @map("deposit_required")
  depositAmount        Int       @default(0)     @map("deposit_amount")

  // Stamped by /api/cron/booking-reminders the first time a 24-hour
  // reminder email fires successfully. Used as the idempotency key so the
  // hourly cron never sends the same reminder twice.
  reminderSentAt       DateTime? @map("reminder_sent_at")

  // Availability + dashboard filter by date / owner / payment status.
  @@index([date])
  @@index([ownerId])
  @@index([status])
  @@index([groupId])
}

/// User-editable email automations attached to bookings. Two are seeded
/// as defaults on first load:
///   • "confirmation"   — sent immediately when a booking is created
///   • "reminder_24h"   — sent by the daily cron 24 hours before the slot
/// Both can be toggled off, edited (subject + body), or supplemented with
/// extra rows for follow-up emails. Body uses {{variable}} placeholders
/// substituted at send time (see src/lib/booking-automation.ts).
model BookingAutomation {
  id                 String   @id @default(cuid())
  key                String   @unique // stable id used by send code
  label              String              // "Booking confirmation"
  description        String   @db.Text  // shown in the admin UI
  triggerType        String   @map("trigger_type") // "on_booking" | "before_appointment"
  triggerHoursBefore Int?     @map("trigger_hours_before") // for "before_appointment"
  enabled            Boolean  @default(true)
  subject            String   @db.Text
  bodyHtml           String   @db.Text @map("body_html")
  /// Defaults are protected from deletion in the UI (the send code refers
  /// to their keys). User-added automations can be deleted freely.
  isDefault          Boolean  @default(false) @map("is_default")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("booking_automations")
}

/// Single source of truth for the booking T&Cs the client agrees to at
/// /book step 3. Stored as a singleton (id="default") with the clause
/// array as JSON so admin edits don't require a migration. The `version`
/// is a free-text label (we use ISO date by convention) — Booking rows
/// reference it via `acceptedTermsVersion` so we always know which copy
/// any given client signed off on, even after edits.
model BookingTermsConfig {
  id        String   @id @default("default")
  version   String                                       // e.g. "2026-04-29"
  clauses   Json     @default("[]")                      // Array<TermsClause>
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("booking_terms_config")
}

model PrivateConfig {
  id         String   @id @default("singleton")
  incomeGoal Int      @default(250000)
  updatedAt  DateTime @updatedAt
}

model IncomeEntry {
  id          String   @id @default(cuid())
  amount      Int // amount in GBP (pounds)
  source      String // "BOOKING" | "MANUAL" | "FIREBUDDY"
  reference   String? // e.g. booking id, external payment id
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([source, reference])
  @@index([occurredAt])
}

model Task {
  id            String   @id @default(cuid())
  title         String
  description   String?
  priority      String   @default("medium") // "low" | "medium" | "high" | "urgent"
  status        String   @default("todo")   // "todo" | "in_progress" | "done"
  dueDate       DateTime?
  createdById   String
  createdBy     User     @relation("TasksCreated", fields: [createdById], references: [id])
  // If set, this task is shared with this CLIENT user via /portal/feedback.
  clientUserId  String?
  clientUser    User?    @relation("TasksForClient", fields: [clientUserId], references: [id])
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Build lifecycle timestamps (CRM-style table view on /tasks) ───
  // Stamped server-side whenever status flips to "in_progress" (i.e.
  // "sent to Paddy to build"). `firstBuildAt` is locked-in on the FIRST
  // such flip and never overwritten — useful for measuring how long a
  // request sat before getting picked up. `latestBuildAt` always tracks
  // the most recent flip and bumps every time the user re-pings ("I've
  // looked at it, please iterate").
  firstBuildAt  DateTime? @map("first_build_at")
  latestBuildAt DateTime? @map("latest_build_at")
  // Stamped the FIRST time a task is moved to "for_review" — i.e. when the
  // fix was actually delivered back for checking. This is the true measure
  // of how fast we turn a request around: logged → for_review. It is NOT
  // completedAt (that includes however long Grace/Claire take to verify,
  // which isn't a reflection of fix speed). Locked on first for_review.
  forReviewAt   DateTime? @map("for_review_at")

  assignees     TaskAssignee[]
  subtasks      Subtask[]
  comments      TaskComment[]
  feedback      TaskFeedback[]
  attachments   TaskAttachment[]

  @@index([status])
  @@index([dueDate])
  @@index([clientUserId])
}

/// Images/videos attached to a task itself (not to a comment) — e.g. a
/// screenshot uploaded when logging the ticket to show the issue. Mirrors
/// CommentAttachment; files live on Vercel Blob (uploaded via
/// /api/uploads/comment-attachment) and only the URL + metadata are stored.
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url       String
  mimeType  String
  filename  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([taskId])
}

/// Quick-tap feedback rows for the /tasks "Build Updates" view. Each row
/// is one click of the Works / Issue / Suggestion / Confused chips on a
/// task card, plus an optional free-text note. Used so Patrick can leave
/// rapid-fire notes against shipped features and Claude can pull them
/// back as a batch when picking the next thing to fix.
model TaskFeedback {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// "works" | "issue" | "suggestion" | "confused"
  kind      String
  message   String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  /// Resolved when Claude has actioned the note (or it's been dismissed).
  resolvedAt DateTime? @map("resolved_at")

  @@index([taskId, createdAt])
  @@map("task_feedback")
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Subtask {
  id      String  @id @default(cuid())
  taskId  String
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title   String
  done    Boolean @default(false)
  order   Int     @default(0)

  @@index([taskId])
}

model TaskComment {
  id          String              @id @default(cuid())
  taskId      String
  task        Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime            @default(now())
  attachments CommentAttachment[]

  @@index([taskId])
}

model CommentAttachment {
  id        String      @id @default(cuid())
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  mimeType  String
  filename  String
  sizeBytes Int
  createdAt DateTime    @default(now())

  @@index([commentId])
}

// ─── Scratch notes (team-wide reference content) ────────────────────

model Note {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text  // rich HTML authored via RichTextEditor
  authorId  String
  author    User     @relation("UserNotes", fields: [authorId], references: [id])
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([pinned])
  @@index([updatedAt])
}

// ─── Live Sessions (LiveKit) ────────────────────────────────────────
// Ported from the live-stream package in /livestream. Supabase-style
// table names (live_rooms, live_recordings) are preserved via @@map
// so the provided SQL migrations + webhook signatures still line up.

/// A Zoom cloud recording that's been pulled across to Vimeo, ready to be
/// published as course content. One row per Zoom recording.
///
/// Flow: Zoom `recording.completed` webhook → we hand Vimeo the Zoom download
/// URL and Vimeo PULLS the file itself (so a multi-GB video never streams
/// through a serverless function) → we poll transcode status → an admin
/// publishes it onto a course Module (videoUrl) and/or a LiveRoom (mediaUrl).
model RecordingSync {
  id              String    @id @default(cuid())
  /// Zoom meeting UUID — the idempotency key; Zoom can deliver a webhook twice.
  zoomMeetingUuid String    @unique @map("zoom_meeting_uuid")
  zoomMeetingId   String?   @map("zoom_meeting_id")
  topic           String
  startedAt       DateTime  @map("started_at")
  durationMin     Int       @default(0) @map("duration_min")
  /// Stored in MB (not bytes) to keep it a plain Int — recordings exceed 2^31 bytes.
  sizeMb          Int?      @map("size_mb")
  vimeoUri        String?   @map("vimeo_uri")
  vimeoLink       String?   @map("vimeo_link")
  /// The custom poster image we last applied to the Vimeo video (our Blob
  /// URL). Null = never set, so Vimeo is showing an auto-picked frame.
  /// Stored so the admin can see the current thumbnail without calling out
  /// to Vimeo on every page load.
  thumbnailUrl    String?   @map("thumbnail_url")
  /// pending | uploading | transcoding | ready | failed
  status          String    @default("pending")
  error           String?   @db.Text
  /// Where it's been published (soft references — content can be deleted).
  publishedModuleId   String?   @map("published_module_id")
  publishedLiveRoomId String?   @map("published_live_room_id")
  publishedAt         DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  resources       RecordingResource[]

  @@index([status])
  @@index([startedAt])
  @@map("recording_sync")
}

/// Handouts, slides and links that belong with a recording. Attached to the
/// recording rather than the lesson so they can be prepared before it's
/// published — the lesson page looks them up via the recording that was
/// published to it, so learners get them alongside the video.
model RecordingResource {
  id          String        @id @default(cuid())
  recordingId String        @map("recording_id")
  recording   RecordingSync @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  title       String
  url         String
  /// "file" (uploaded) | "link" (external URL)
  kind        String        @default("file")
  mimeType    String?       @map("mime_type")
  sizeBytes   Int?          @map("size_bytes")
  order       Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([recordingId, order])
  @@map("recording_resources")
}

model LiveRoom {
  id                String              @id @default(cuid())
  title             String
  description       String              @default("") @db.Text
  mode              String              @default("broadcast") // "broadcast" | "interactive"
  status            String              @default("scheduled") // "scheduled" | "live" | "ended" | "cancelled"
  scheduledStart    DateTime            @map("scheduled_start")
  scheduledEnd      DateTime?           @map("scheduled_end")
  actualStart       DateTime?           @map("actual_start")
  actualEnd         DateTime?           @map("actual_end")
  // Optional host — points at whoever's broadcasting. Null until assigned.
  hostId            String?             @map("host_id")
  host              User?               @relation("LiveRoomsHosted", fields: [hostId], references: [id], onDelete: SetNull)
  livekitRoomName   String              @unique @map("livekit_room_name")
  maxParticipants   Int                 @default(100) @map("max_participants")
  requireAuth       Boolean             @default(false) @map("require_auth")
  viewerCountPeak   Int                 @default(0) @map("viewer_count_peak")
  notes             String              @default("") @db.Text
  mediaUrl          String?             @map("media_url")
  brandingTitle     String?             @map("branding_title")
  brandingLogoUrl   String?             @map("branding_logo_url")
  /// Cover image for the session — shown on the join page before it starts
  /// and as the thumbnail in listings. 16:9. Distinct from brandingLogoUrl
  /// (a small logo overlaid on the stream).
  posterUrl         String?             @map("poster_url")
  createdAt         DateTime            @default(now()) @map("created_at")

  recordings        LiveRecording[]
  resources         LiveRoomResource[]

  @@index([hostId])
  @@index([status])
  @@index([scheduledStart])
  @@map("live_rooms")
}

/// Handouts, slides and links attached to a live session, so attendees can
/// grab the relevant material without it being emailed round separately.
/// Files live on Vercel Blob; `kind` distinguishes an uploaded file from a
/// plain external link.
model LiveRoomResource {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title     String
  url       String
  /// "file" (uploaded) | "link" (external URL)
  kind      String   @default("file")
  mimeType  String?  @map("mime_type")
  sizeBytes Int?     @map("size_bytes")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, order])
  @@map("live_room_resources")
}

model LiveRecording {
  id               String    @id @default(cuid())
  liveRoomId       String    @map("live_room_id")
  liveRoom         LiveRoom  @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  livekitEgressId  String?   @map("livekit_egress_id")
  status           String    @default("recording") // "recording" | "processing" | "ready" | "failed"
  storageUrl       String?   @map("storage_url")
  storageKey       String?   @map("storage_key")
  durationSeconds  Int?      @map("duration_seconds")
  fileSizeBytes    BigInt?   @map("file_size_bytes")
  thumbnailUrl     String?   @map("thumbnail_url")
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([liveRoomId])
  @@index([status])
  @@map("live_recordings")
}

// ─── Progress Notes (SOAP format) ───────────────────────────────────

model ProgressNote {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  sessionDate DateTime
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

// ─── Client Goals + Reviews ─────────────────────────────────────────

model ClientGoal {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  achieved    Boolean   @default(false)
  reviewNote  String?   @db.Text
  parentNote  String?   @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
}

// ─── Audit log ──────────────────────────────────────────────────────
//
// Append-only record of sensitive admin actions. Underpins the
// incident-response runbook (docs/incident-response.md):
// "Why it took as long as it did to detect / contain" needs a clear
// timeline that doesn't depend on memory. Writes are best-effort and
// must NEVER block the originating action from completing.
//
// Actor is nullable because we want to keep entries even after a
// User row is deleted (SetNull) — the action still happened.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditEntries", fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot of actor identity at the moment of the action, so the
  /// record reads correctly even if the User row is later renamed or
  /// deleted. e.g. "Grace Magennis <patrick@thesensorysubmarine.com>".
  actorLabel String
  action     String                // "invoice.send" | "report.delete" | "client.delete" | "impersonate.start" | …
  targetType String                // "invoice" | "report" | "client" | "user" | …
  targetId   String?               // FK-less string — survives target deletion
  /// Free-form JSON payload — descriptive metadata only, never
  /// secrets/tokens/passwords. Examples: { invoiceNumber, total } for
  /// an invoice send; { clientName, recordCounts } for a client delete.
  meta       Json     @default("{}")
  ip         String?               // request IP (best effort, may be proxy)
  userAgent  String?               // truncated
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Services (billing catalogue) ───────────────────────────────────
//
// A list of products / services Patrick can quickly pick from when
// building an invoice. Kept separate from BookingService (which is
// the public /book catalogue) on purpose — invoice items include
// non-bookable things like reports, materials, training packages.
model Service {
  id          String   @id @default(cuid())
  name        String                            // shown in picker + line description
  description String   @db.Text @default("")    // optional notes (not shown on invoice unless copied)
  /// Default unit price in pence. 0 = "quote / set on invoice".
  pricePence  Int      @default(0)
  /// "GBP" | "EUR" | "USD". Picker filters by invoice currency.
  currency    String   @default("GBP")
  /// Optional free-text category (e.g. "Sessions", "Reports", "Materials").
  category    String   @default("")
  /// Optional default tax rate. Picked from Settings → Tax rates.
  /// Soft FK (SetNull) so deleting a tax rate doesn't break the
  /// service — the invoice picker just falls back to "no tax".
  defaultTaxRateId String?
  defaultTaxRate   TaxRate? @relation(fields: [defaultTaxRateId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
  @@map("services")
}

// ─── Invoices ───────────────────────────────────────────────────────

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique            // e.g. "INV-0001"
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName    String                       // snapshot — always filled even if no clientId
  clientEmail   String
  // Snapshot of the client's billing address at invoice time, so editing
  // the client later doesn't rewrite history. Free-text, multi-line.
  clientAddress String?   @db.Text
  currency      String    @default("GBP")    // GBP | EUR | USD
  // When true, the invoice shows a "Pay by bank transfer" block with the
  // practice bank details (PaymentSettings) + this invoice number as the
  // reference. Used for schools / EA finance who pay by BACS.
  bankTransfer  Boolean   @default(false)    @map("bank_transfer")
  status        String    @default("draft")  // "draft" | "sent" | "paid" | "overdue" | "cancelled"
  dueDate       DateTime
  notes         String?   @db.Text
  subtotal      Int       @default(0)        // pence
  tax           Int       @default(0)        // pence
  total         Int       @default(0)        // pence
  paymentRef    String?                      // FireBuddy payment code
  paymentUrl    String?                      // FireBuddy payment URL
  /// Mirror invoice ID in FireBuddy's Accounting → Invoices view.
  /// Created on first send so the accountant has a clean parallel
  /// record. Updated to status=paid via the FireBuddy webhook on
  /// settlement. Optional — older invoices won't have it.
  firebuddyInvoiceId String?
  paidAt        DateTime?
  // How the payment was confirmed. "fire" = landed in the Fire account
  // (the source of truth, set by sync/webhook). "cash" | "bank_transfer"
  // | "other" = manually marked paid off-Fire, so it legitimately won't
  // appear in Fire. Null on unpaid invoices.
  paidMethod    String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  items         InvoiceItem[]

  @@index([clientId])
  @@index([status])
  // Dashboard revenue/outstanding aggregates filter on these.
  @@index([paidAt])
  @@index([dueDate])
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int    @default(1)
  unitPrice   Int                            // pence
  amount      Int                            // quantity * unitPrice, in pence

  @@index([invoiceId])
}

// ─── Client Intake Items (questionnaires, SPM, etc.) ────────────────

model ClientIntakeItem {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String    // "parent_questionnaire" | "spm" | custom
  label       String
  url         String?
  status      String    @default("pending") // "pending" | "sent" | "completed"
  sentAt      DateTime?
  completedAt DateTime?
  notes       String?   @db.Text
  fileUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
}

// ─── Forms — JotForm-style builder + public submissions ────────────
// Fields and settings are stored as JSON; canonical types live in
// src/lib/forms.ts. Sanitisation happens on every read/write boundary.
model Form {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique               // public path: /f/{slug}
  description String?  @db.Text
  fields      Json     @default("[]")        // Array<FormField>
  settings    Json     @default("{}")        // { submitButtonText, successMessage, notifyEmails, replyToEmail, autoReply? }
  isPublished Boolean  @default(false)
  createdById String
  createdBy   User     @relation("FormsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  submissions FormSubmission[]
  invites     FormInvite[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model FormSubmission {
  id             String      @id @default(cuid())
  formId         String
  form           Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  inviteId       String?
  invite         FormInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  data           Json                              // { [fieldId]: value }
  fieldsSnapshot Json                              // frozen copy of Form.fields at submit time
  submitterEmail String?                           // denormalised from the first email field
  submitterName  String?                           // denormalised from the first name-ish text field
  submittedAt    DateTime    @default(now())
  ipHash         String?                           // SHA256 of IP — lightweight abuse signal
  forwardLog     Json?                             // [{ to, note?, sentByName?, sentAt }] — history of who this was emailed/forwarded to

  @@index([formId, submittedAt])
}

model FormInvite {
  id          String           @id @default(cuid())
  formId      String
  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  email       String
  token       String           @unique           // embedded as ?t= on the public URL
  sentAt      DateTime         @default(now())
  openedAt    DateTime?
  submissions FormSubmission[]

  @@index([formId])
  @@index([token])
}

// ─── Leaflets — a library of parent/carer handouts ────────────────
// Each leaflet is either a file uploaded to Vercel Blob or an external URL
// (e.g. Google Drive). The UI gallery filters by category, searches by title.
model Leaflet {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  category     String?  // free-text label, e.g. "Fine Motor", "Feeding"
  // kind is the source of the leaflet body:
  //   "content" — authored natively in the admin (HTML in `content`)
  //   "file"    — uploaded to Vercel Blob (url in `fileUrl`)
  //   "link"    — external URL (Google Drive, website, etc.)
  kind         String   @default("file")
  content      String?  @db.Text        // HTML body when kind = "content"
  fileUrl      String?                  // Blob URL or external URL — null when kind = "content"
  fileName     String?                  // display filename (original upload name)
  mimeType     String?
  sizeBytes    Int?
  thumbnailUrl String?                  // optional preview image URL
  coverImageUrl String?                 // hero image shown on the card + top of the leaflet
  tags         String[] @default([])
  external     Boolean  @default(false) // convenience flag: true when fileUrl points off-app
  createdById  String
  createdBy    User     @relation("LeafletsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([createdById])
}

// ──────────────────────────────────────────────────────────────────────
// Multi-tenant white-label foundation
// ──────────────────────────────────────────────────────────────────────
// These tables are additive — no existing models reference them yet.
// In Phase 1c of the white-label plan, every owned model gains a
// `tenantId` foreign-key that points back to `Tenant.id`. Until that
// migration runs, all live data continues to flow through the
// "submarine" tenant via app-level defaults.

/// One row per white-label customer (and one for the platform itself,
/// for Patrick's cross-tenant admin).
model Tenant {
  id          String   @id @default(cuid())
  /// Subdomain slug — "sarah" produces `sarah.aiworldexperts.com`.
  /// Reserved values: "platform", "www", "app", "api", "admin".
  subdomain   String   @unique
  /// Human-readable business name shown in the UI.
  displayName String
  /// Branding overrides. Shape:
  /// { logoUrl?, primaryColor?, sidebarColor?, footerTagline?, supportEmail? }
  theme       Json     @default("{}")
  /// FK into TenantPlan. Defaults to "starter" — change in TenantPlan to
  /// adjust default features/limits for new signups.
  planKey     String   @default("starter")
  status      String   @default("active") // active | suspended | churned
  /// 14-day trial countdown — null once converted or for platform tenant.
  trialEndsAt DateTime? @map("trial_ends_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt        @map("updated_at")

  plan         TenantPlan          @relation(fields: [planKey], references: [key])
  subscription TenantSubscription?
  features     TenantFeatureAccess[]

  @@map("tenants")
}

/// Catalogue of platform plans. Drives both pricing and feature gating.
/// Seeded with starter / pro / premium rows on first run.
model TenantPlan {
  key             String   @id // "starter" | "pro" | "premium" | "platform"
  label           String
  pricePence      Int                                  // £49 → 4900
  setupFeePence   Int      @default(0) @map("setup_fee_pence")
  /// Feature keys (from features-manifest.ts) included in this plan.
  enabledFeatures String[] @default([]) @map("enabled_features")
  maxClients      Int?     @map("max_clients")
  maxStaff        Int?     @map("max_staff")
  maxStorageMb    Int?     @map("max_storage_mb")
  /// false = enterprise-only, hidden from public signup.
  isPublic        Boolean  @default(true) @map("is_public")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt        @map("updated_at")

  tenants Tenant[]

  @@map("tenant_plans")
}

/// Per-tenant subscription — source of truth for billing state.
/// Hand-rolled on top of FireBuddy (see plan: Risks).
model TenantSubscription {
  id                 String   @id @default(cuid())
  tenantId           String   @unique @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planKey            String   @map("plan_key")
  status             String   @default("trialing") // trialing | active | past_due | cancelled
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  cancelAtPeriodEnd  Boolean  @default(false) @map("cancel_at_period_end")
  /// FireBuddy reference of the most recent successful charge.
  lastPaymentRef     String?  @map("last_payment_ref")
  /// Consecutive failed renewals — drives dunning email cadence.
  failedAttempts     Int      @default(0) @map("failed_attempts")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt        @map("updated_at")

  @@map("tenant_subscriptions")
}

/// Per-tenant feature add-ons. A tenant has a feature if EITHER (a) their
/// `Tenant.plan.enabledFeatures` includes its key, OR (b) a row in this
/// table grants it. Used for one-off paid add-ons ("Add Schools Dashboard
/// +£15/mo") and for Patrick to grant courtesy access during demos.
model TenantFeatureAccess {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Feature key matching an entry in src/lib/features-manifest.ts.
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(true)
  enabledAt  DateTime @default(now()) @map("enabled_at")
  /// Pence — used for revenue reporting, not as the source of truth for
  /// billing (that's the subscription/charge record).
  paidPence  Int      @default(0) @map("paid_pence")
  /// Free-text admin note ("comp for beta tester", "refunded 2026-Q3").
  note       String   @default("") @db.Text

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@map("tenant_feature_access")
}

/// Misc practice-wide settings. Singleton (id="default"). Holds small
/// admin-editable values that don't warrant their own model.
model PracticeSettings {
  id         String   @id @default("default")
  /// The standard Sensory Processing Measure (SPM) assessment link
  /// (WPS Hub). Pre-fills the "Add SPM" dialog on a client record so
  /// the OT doesn't retype it for every client. URL only — no
  /// credentials are ever stored here.
  spmLinkUrl String?  @map("spm_link_url")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@map("practice_settings")
}

/// Tracking + analytics integrations. Singleton today (id="default")
/// for parity with EmailSettings/PaymentSettings; will become per-
/// tenant in Phase 1c of the white-label plan.
model TrackingSettings {
  id               String   @id @default("default")
  /// Microsoft Clarity Project ID (the alphanumeric token from
  /// clarity.microsoft.com → Setup → Tracking code). When null or
  /// empty, the script doesn't render and no data is sent.
  clarityProjectId String?  @map("clarity_project_id")
  /// Meta (Facebook) Pixel ID — the 15-16 digit number from Events
  /// Manager → Data sources → your pixel. Used for tracking FB/IG ad
  /// conversions back to Ads Manager (works for Ad Center boosts too).
  /// Empty/null means the pixel script doesn't render.
  metaPixelId      String?  @map("meta_pixel_id")
  /// Master kill-switch — flip to false to immediately stop loading
  /// the Clarity/Pixel scripts anywhere without removing the IDs.
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt @map("updated_at")
  @@map("tracking_settings")
}

/// Admin-editable copy for the public courses storefront. Singleton
/// (id="default") for parity with EmailSettings / PaymentSettings.
/// Becomes per-tenant in Phase 1c of the white-label plan.
model StorefrontConfig {
  id        String   @id @default("default")
  /// Small text above the big title — was "Training that makes a
  /// difference". Free-text, ~120 chars enforced in the form.
  tagline   String?
  /// The big hero headline. Defaults to the new wording when null.
  heroTitle String?  @map("hero_title")
  /// Supporting paragraph under the title.
  heroBlurb String?  @map("hero_blurb") @db.Text
  /// Show the "Home" link in the public header. Hiding it doesn't
  /// disable the landing page — it just removes the explicit nav
  /// link, leaving only Book a session (plus any others kept on).
  showHomeNav        Boolean  @default(true) @map("show_home_nav")
  /// Show the "Courses" link in the public header + footer AND the
  /// course-related sections on the landing page (Browse courses
  /// hero button, Online courses card, featured courses shelf,
  /// See all courses CTA, footer link). Single switch for the
  /// whole courses surface so Patrick can take it dark in one tap.
  showCoursesNav     Boolean  @default(true) @map("show_courses_nav")
  /// Show the "Sign in" button in the public header + footer link.
  /// Hiding it doesn't disable the /login page — it just stops
  /// advertising it.
  showSignIn         Boolean  @default(true) @map("show_sign_in")
  /// Show the "Create account" CTA + register link in the public
  /// header + footer. Disabling pauses new self-serve sign-ups
  /// without changing the /register endpoint itself.
  showCreateAccount  Boolean  @default(true) @map("show_create_account")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("storefront_config")
}
