# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit ---
# Optional — these are used as fallback if the admin settings page has not
# been configured yet. Once the settings table is populated, those values
# take precedence.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://<your-project>.livekit.cloud

# --- Recording storage (S3-compatible) ---
# For Supabase Storage, endpoint = https://<project>.supabase.co/storage/v1/s3
# Generate an access key pair in Supabase Studio > Storage > S3.
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
RECORDING_S3_REGION=eu-west-3
RECORDING_S3_BUCKET=recordings
RECORDING_S3_FORCE_PATH_STYLE=true
